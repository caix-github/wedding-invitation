<!-- 模板切换按钮 -->
<view class="tpl-switch" bindtap="switchTemplate">
    <view class="tpl-switch-inner">
        <text class="tpl-switch-icon">{{ currentTemplate === 'classic' ? '🎵' : '囍' }}</text>
        <text class="tpl-switch-text">{{ currentTemplate === 'classic' ? '五迷模式' : '经典模式' }}</text>
    </view>
</view>

<!-- 音乐播放器（经典+五迷共用）悬浮图标+展开面板 -->
<view wx:if="{{ magic }}" class="music-float {{ musicExpanded ? 'expanded' : '' }} {{ musicClosed ? 'closed' : '' }}">
    <!-- 收起状态：小圆点 -->
    <view wx:if="{{ musicClosed }}" class="music-float-mini" bindtap="reopenMusic">
        <text class="music-float-mini-icon">🎵</text>
    </view>
    <!-- 正常状态：图标+面板 -->
    <block wx:else>
        <view class="music-float-icon {{ musicIsPaused ? 'paused' : '' }}" bindtap="toggleMusicPanel">
            <image src="../../images/icon/music.png" mode="aspectFit" />
        </view>
        <view class="music-float-panel" wx:if="{{ musicExpanded }}">
            <view class="music-float-info" bindtap="toggleMusic">
                <view class="music-float-name">{{ music.name }}</view>
                <view class="music-float-singer">{{ music.singer }} · {{ musicIsPaused ? '已暂停' : '播放中' }}</view>
            </view>
            <image class="music-float-poster" src="{{ imgs.poster }}" mode="aspectFit" />
            <view class="music-float-close" bindtap="closeMusic">×</view>
        </view>
    </block>
</view>

