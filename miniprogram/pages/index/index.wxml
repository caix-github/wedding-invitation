</view>

<!-- 表单 -->
<form wx:if="{{ magic }}" bindsubmit="submit">
    <view class="form tc mb100">
        <view>
            <text>*</text>
            <input type="text" placeholder="姓名" name="name" value="{{ form.name }}" placeholder-class="form-input-placeholder" maxlength="10" />
        </view>
        <view>
            <text>*</text>
            <input type="number" placeholder="出席人数" name="num" value="{{ form.num }}" placeholder-class="form-input-placeholder" maxlength="2" />
        </view>
        <view>
            <textarea type="text" placeholder="祝福语，可以上墙哦~" name="greeting" value="{{ form.greeting }}" placeholder-class="form-input-placeholder" maxlength="140" disable-default-padding />
        </view>
        <button form-type="submit" open-type="getUserInfo">{{ form.name ? '更新' : '提交' }}</button>
    </view>
</form>

<!-- 温馨提示 -->
<view class="md-tips-card">
    <image class="md-tips-img" src="{{ maydayImgs.extra6 || maydayImgs.mascot }}" mode="aspectFit" />
    <view class="md-tips-label">温馨 Tips</view>
    <view class="md-lyric-sub">请预留好{{ weddingTimeStr[4] }}这一天的行程</view>
    <view class="md-lyric-sub">如果被事务牵绊或临时有变化</view>
    <view class="md-lyric-sub">请提前告知新郎/新娘</view>
</view>

<!-- 结尾 -->
<view class="md-ending">
    <view class="md-ending-lyric">后来的我们</view>
    <view class="md-ending-lyric">依然走着</view>
    <view class="md-ending-lyric">只是不再并肩了</view>
    <view class="md-ending-lyric md-accent">朝各自的人生追寻了</view>
    <view class="md-ending-sign">{{ couple[0].name }} & {{ couple[1].name }}</view>
</view>

</block><!-- /五迷模板 -->

<!-- 祝福语轮播以及底部快捷跳转（共用） -->
<view wx:if="{{ magic }}" class="greetings">
    <view class="greetings-list">
        <view class="greetings-item {{ activeIdx === index ? 'active' : '' }}" wx:for="{{ greetings }}" wx:key="_id" bind:animationend="onAnimationend"><text class="greetings-name">{{ item.name }}：</text>{{ item.greeting || '新婚快乐' }}</view>
    </view>
    <view class="controller">
        <view class="controller-btn">
            <image bindtap="goPhone" src="../../images/icon/phone.png" mode="widthFix" />
        </view>
        <view class="controller-btn">
            <image bindtap="goWrite" src="../../images/icon/write.png" mode="widthFix" />
        </view>
        <view class="controller-btn">
            <image bindtap="openLocation" src="../../images/icon/go.png" mode="widthFix" />
        </view>
    </view>
</view>

<!-- 公告栏入口（共用） -->
<view wx:if="{{ isManager }}" class="manager">
    <image bindtap="goInfo" src="../../images/icon/manager.png" mode="widthFix"/>
</view>
