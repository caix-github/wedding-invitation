/* 音乐悬浮组件 */
.music-float {
    position: fixed;
    top: 20rpx;
    right: 20rpx;
    z-index: 99999999;
    display: flex;
    align-items: center;
}

.music-float-icon {
    background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
    border-radius: 50%;
    width: 72rpx;
    height: 72rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.35);
    -webkit-animation: mrotate 5s linear infinite;
    animation: mrotate 5s linear infinite;
    overflow: hidden;
    flex-shrink: 0;
}

.music-float-icon.paused {
    -webkit-animation: none;
    animation: none;
    background: linear-gradient(135deg, #ccc 0%, #ddd 100%);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.music-float-icon.paused::after {
    content: "";
    width: 72rpx;
    height: 0;
    position: absolute;
    top: 34rpx;
    left: 0;
    border-top: 4rpx solid rgba(255, 255, 255, 0.8);
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg);
}

.music-float-icon image {
    width: 40rpx;
    height: 40rpx;
}

.music-float-panel {
    display: flex;
    align-items: center;
    margin-right: 12rpx;
    padding: 10rpx 16rpx 10rpx 20rpx;
    background: linear-gradient(135deg, #FFF5F0 0%, #FFF0EB 100%);
    border: 2rpx solid rgba(255, 107, 107, 0.15);
    border-radius: 36rpx;
    box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.15);
    gap: 14rpx;
    -webkit-animation: musicSlideIn 0.3s ease;
    animation: musicSlideIn 0.3s ease;
}

@-webkit-keyframes musicSlideIn {
    from { opacity: 0; transform: translateX(40rpx); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes musicSlideIn {
    from { opacity: 0; transform: translateX(40rpx); }
    to { opacity: 1; transform: translateX(0); }
}

.music-float-info {
