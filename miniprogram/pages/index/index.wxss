}

/* 邀请函卡片 */
.md-invite-card {
    margin: 60rpx 40rpx;
    padding: 60rpx 40rpx;
    background: linear-gradient(180deg, #FFFDE7 0%, #FFF8E1 100%);
    border-radius: 24rpx;
    text-align: center;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .06);
}

.md-invite-header {
    font-size: 30rpx;
    font-weight: 700;
    color: #F57C00;
    letter-spacing: 6rpx;
}

.md-invite-deco-line {
    width: 100%;
    height: 2rpx;
    background: linear-gradient(90deg, transparent, #F57C00, transparent);
    margin: 30rpx 0;
}

.md-invite-body {
    padding: 20rpx 0;
}

.md-invite-names {
    font-size: 40rpx;
    font-weight: 700;
    color: #E53935;
    margin-bottom: 30rpx;
    letter-spacing: 3rpx;
}

.md-invite-text {
    font-size: 28rpx;
    color: #555;
    line-height: 2;
    letter-spacing: 2rpx;
}

.md-invite-text.md-accent {
    font-size: 30rpx;
    font-weight: 600;
    color: #E53935;
    margin-top: 12rpx;
}

.md-invite-footer {
    text-align: center;
    padding-top: 10rpx;
}

/* 温馨提示 */
.md-tips-card {
    margin: 60rpx 40rpx;
    padding: 48rpx 40rpx;
    background: #FAFAFA;
    border-radius: 24rpx;
    text-align: center;
    border-left: 8rpx solid #FF8E53;
}

.md-tips-label {
    font-size: 30rpx;
    font-weight: 700;
    color: #FF6B6B;
    margin-bottom: 24rpx;
    letter-spacing: 2rpx;
}

/* 结尾 */
.md-ending {
    text-align: center;
    padding: 80rpx 40rpx 120rpx;
    background: linear-gradient(180deg, #FFF5F5 0%, #FFEBEE 100%);
    border-radius: 24rpx;
    margin: 0 20rpx;
}

.md-ending-lyric {
    font-size: 30rpx;
    color: #555;
    line-height: 2.2;
    letter-spacing: 2rpx;
}

.md-ending-lyric.md-accent {
    font-size: 32rpx;
    font-weight: 600;
    color: #E53935;
}

.md-ending-sign {
    font-size: 36rpx;
    font-weight: 700;
    color: #E53935;
    margin-top: 40rpx;
    letter-spacing: 4rpx;
}